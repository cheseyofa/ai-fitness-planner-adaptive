# =============================================================================
# .env.example (Template for environment variables)
# =============================================================================
# Copy this file to .env and update the values for your local setup
# Never commit your actual .env file to version control!

# Project Configuration
PROJECT_NAME=ai-fitness-planner
VERSION=0.0.1
ENVIRONMENT=development

# Database Configuration
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=ai_fitness_planner
DB_HOST=ai_fitness_planner_db
DB_PORT=5432

# Database URL (update with your credentials)
DATABASE_URL=postgresql://your_db_username:your_secure_db_password@ai_fitness_planner_db:5432/ai_fitness_planner

# External APIs
OPENAI_API_KEY=
# 聊天服务与食品嵌入服务分别配置，切勿混用不同厂商的密钥。
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_ADVANCED_MODEL=deepseek-v4-pro
# 食品语义搜索需要独立嵌入服务；默认兼容原 OpenAI 索引。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# MongoDB Configuration
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_DB_NAME=usda_nutrition
# Local Python + Docker databases; Compose overrides these for its backend.
MONGO_HOST=localhost
MONGO_PORT=27019

# Mongo Express Configuration  
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=your_mongo_express_password

# External API Base URL, for local: API_BASE_URL="http://fast_api_ai_fitness_planner:8000"
API_BASE_URL=http://your-api-server-url:port

# LangSmith API Key (optional)
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false

# 第一阶段：恢复评分权重，六项之和必须为 1。
READINESS_SLEEP_WEIGHT=0.30
READINESS_HRV_WEIGHT=0.20
READINESS_RHR_WEIGHT=0.15
READINESS_FATIGUE_WEIGHT=0.15
READINESS_SORENESS_WEIGHT=0.10
READINESS_LOAD_WEIGHT=0.10
# 初始工程参数；并非经验证的医学阈值。
READINESS_BASELINE_SLEEP_HOURS=8
READINESS_LOAD_REFERENCE=3000

# 自适应训练工具；默认只使用本地动作与无视频模式。
EXERCISE_PROVIDER=local
VIDEO_PROVIDER=mock
RECOVERY_PROVIDER=manual
WGER_BASE_URL=https://wger.de
WGER_API_KEY=
WGER_MCP_URL=
WGER_MCP_TOKEN=
WGER_MCP_SEARCH_TOOL=search_exercises
YOUTUBE_API_KEY=
